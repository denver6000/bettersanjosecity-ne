# Copy to .env and fill in. Never commit .env.
#
# Development: .env sits in the project root.
# Hostinger:   .env sits in your home folder, ABOVE public_html (never inside it).

# KloudTrack weather station API key, sent by public/api/weather-station.php.
# Ask a maintainer for it. Without it, the weather card falls back to Open-Meteo.
KCLOUD_API_KEY=

# PSA Classification API token. Optional: the site ships src/data/psic.json,
# generated from PSA's workbook, and does not call PSA's API.
PSA_API_KEY=

# Scholarship system (SIS) portal key, sent by public/api/scholarship-stats.php and
# public/api/scholar-lookup.php. Must equal PORTAL_API_KEY in the SIS's .env. Without it,
# /scholarship shows no figures and the Student ID lookup is unavailable.
SIS_PORTAL_API_KEY=
# Optional: point the proxy at another SIS, e.g. http://127.0.0.1:8000 for local testing.
SIS_URL=
