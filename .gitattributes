# Store text with LF line endings so Windows and macOS/Linux contributors produce
# the same diffs (Prettier also writes LF).
* text=auto eol=lf

# Binary files: never touch line endings, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Generated by scripts/psic-to-json.py; collapse in GitHub diffs
src/data/psic.json linguist-generated=true -diff
package-lock.json linguist-generated=true
